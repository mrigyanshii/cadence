{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence",
  "compatibility_date": "2026-09-29",
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
